              "width",
              "height",
              "settings"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "storage"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "settings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "style"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "style": {
                    "enum": [
                      "bars",
                      "table"
                    ]
                  },
                  "source": {
                    "enum": [
                      "sample",
                      "mounted-storage"
                    ]
                  },
                  "grouping": {
                    "enum": [
                      "drives",
                      "partitions"
                    ]
                  },
                  "mounts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "grouping": {
                          "const": "drives"
                        }
                      },
                      "required": [
                        "grouping"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "mounts"
                        ]
                      }
                    }
                  }
                ]
              },
              "colors": {
                "$ref": "#/$defs/widgetColors"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "x",
              "y",
              "width",
              "height",
              "settings"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "image"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "settings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "data",
                  "fit",
                  "opacity"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "data": {
                    "type": "string",
                    "maxLength": 524288,
                    "pattern": "^data:image/png;base64,[A-Za-z0-9+/]+={0,2}$",
                    "description": "Canonical base64 of a complete static PNG; no URLs, SVG, paths, animation or trailing bytes. Both URI and decoded PNG are limited to 512 KiB. Runtime validation checks PNG structure, checksums and dimensions."
                  },
                  "fit": {
                    "enum": [
                      "contain",
                      "cover",
                      "stretch"
                    ]
                  },
                  "opacity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "colors": {
                "$ref": "#/$defs/widgetColors"
              }
            }
          },
