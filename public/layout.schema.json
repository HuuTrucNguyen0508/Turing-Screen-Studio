                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "settings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "time",
                  "date",
                  "format",
                  "showDate"
                ],
