                  }
                }
              },
              "colors": {
                "$ref": "#/$defs/widgetColors"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "x",
              "y",
              "width",
              "height",
              "settings"
            ],
            "properties": {
              "id": {
