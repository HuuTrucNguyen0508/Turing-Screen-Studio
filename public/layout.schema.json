    }
  },
  "$defs": {
    "clockElementDesign": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "dx": {
          "type": "integer",
          "minimum": -512,
          "maximum": 512
        },
        "dy": {
          "type": "integer",
          "minimum": -512,
          "maximum": 512
        },
        "size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 160
        },
        "color": {
          "oneOf": [
            {
              "enum": [
                "text",
                "muted",
                "primary",
                "secondary"
              ]
            },
            {
              "type": "string",
              "minLength": 7,
              "maxLength": 7,
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ]
        }
      }
    },
    "clockDesign": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "elements": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "label": {
              "$ref": "#/$defs/clockElementDesign"
            },
            "time": {
              "$ref": "#/$defs/clockElementDesign"
            },
            "date": {
              "$ref": "#/$defs/clockElementDesign"
            }
          }
        }
      }
    },
    "widgetColors": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "background": {
