                    "type": "boolean"
                  },
                  "source": {
                    "enum": [
                      "sample",
                      "clock"
                    ]
                  }
                }
              },
              "design": {
                "$ref": "#/$defs/clockDesign"
              },
              "colors": {
                "$ref": "#/$defs/widgetColors"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "x",
              "y",
              "width",
              "height",
              "settings"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "text"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
