                  "min",
                  "max",
                  "unit",
                  "detail"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "source": {
                    "enum": [
                      "sample",
                      "cpu",
                      "gpu",
                      "memory",
                      "disk",
                      "network-down",
                      "network-up",
                      "cpu-temperature",
                      "gpu-temperature",
                      "codex-tokens",
                      "codex-cost",
                      "codex-weekly",
                      "codex-reset",
                      "codex-models",
                      "claude-tokens",
                      "claude-cost",
                      "claude-session",
                      "claude-weekly",
                      "claude-reset",
                      "claude-models",
                      "storage"
                    ]
                  },
                  "style": {
                    "type": "string",
