{
  "version": 1,
  "name": "New widgets showcase",
  "canvas": {
    "width": 1280,
    "height": 800
  },
  "palette": {
    "name": "dynamic",
    "background": "#0a0f0f",
    "surface": "#131b1b",
    "surfaceRaised": "#192121",
    "text": "#dce8e7",
    "muted": "#a2adad",
    "primary": "#9bd0d1",
    "secondary": "#b0cccc",
    "outline": "#3f4a4a"
